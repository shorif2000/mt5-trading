# Official calendar pages are committed (public; sha256 recorded). The 96 BLS release documents
# (~112 MB) are not: data/calendar/bls_release_evidence.tsv keeps each one's URL, sha256 and
# embargo statement. Browser-saved page assets are not needed.
data/calendar/raw/bls/releases/
data/calendar/raw/**/*_files/
